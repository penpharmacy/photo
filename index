<!DOCTYPE html>
<html lang="th" class="h-full bg-slate-900 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photo Studio & Frame Creator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;700&family=Itim&family=Mitr:wght@400;600&family=Prompt:wght@300;400;600;700&family=Sriracha&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        prompt: ['Prompt', 'sans-serif'],
                        itim: ['Itim', 'cursive'],
                        sriracha: ['Sriracha', 'cursive'],
                        mitr: ['Mitr', 'sans-serif'],
                        chakra: ['Chakra Petch', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for better look */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .canvas-container {
            touch-action: none;
        }
    </style>
</head>
<body class="h-full flex flex-col font-prompt overflow-hidden bg-slate-950 text-slate-100">

    <!-- Header -->
    <header class="bg-slate-900 border-b border-slate-800 px-4 py-3 flex items-center justify-between z-20 shrink-0">
        <div class="flex items-center space-x-3">
            <div class="p-2 bg-gradient-to-tr from-indigo-500 to-pink-500 rounded-xl shadow-lg shadow-indigo-500/30">
                <i class="fa-solid font-bold fa-camera-retro text-xl text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
                    Photo Studio & Frame
                </h1>
                <p class="text-xs text-slate-400">แต่งรูป ถ่ายภาพ ใส่กรอบ & สติกเกอร์</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <button id="btnResetCanvas" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs sm:text-sm font-medium transition flex items-center gap-1.5 border border-slate-700">
                <i class="fa-solid fa-rotate-left"></i>
                <span class="hidden sm:inline">รีเซ็ต</span>
            </button>
            <button id="btnDownload" class="px-4 py-1.5 rounded-lg bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white text-xs sm:text-sm font-semibold shadow-lg shadow-pink-500/25 transition flex items-center gap-2">
                <i class="fa-solid fa-download"></i>
                <span>ดาวน์โหลด</span>
            </button>
        </div>
    </header>

    <!-- Main Content Grid -->
    <main class="flex-1 flex flex-col lg:flex-row overflow-hidden relative">
        
        <!-- Left/Top: Canvas Interactive Workspace -->
        <section class="flex-1 bg-slate-950 flex flex-col items-center justify-center p-4 relative overflow-hidden select-none">
            
            <!-- Canvas Wrapper -->
            <div id="canvasWrapper" class="relative max-w-full max-h-full flex items-center justify-center flex-1 w-full h-full">
                <canvas id="mainCanvas" class="max-w-full max-h-full rounded-xl shadow-2xl border border-slate-800 cursor-crosshair bg-slate-900"></canvas>
            </div>

            <!-- Canvas Controls Overlay (Dimensions & Clear Selected) -->
            <div class="absolute bottom-4 left-4 right-4 flex justify-between items-center pointer-events-none z-10">
                <div class="pointer-events-auto bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-700/50 text-xs text-slate-300 flex items-center gap-2 shadow-lg">
                    <i class="fa-solid fa-expand text-slate-400"></i>
                    <span id="canvasDimText">1080 x 1080 px</span>
                </div>

                <div id="selectedElementToolbar" class="pointer-events-auto hidden bg-slate-900/90 backdrop-blur-md px-3 py-1.5 rounded-full border border-pink-500/40 text-xs text-slate-200 flex items-center gap-3 shadow-xl">
                    <span class="text-pink-400 font-medium"><i class="fa-solid fa-square-check mr-1"></i>เลือกวัตถุอยู่</span>
                    <button id="btnDeleteSelected" class="hover:text-red-400 transition text-red-300 flex items-center gap-1 font-semibold">
                        <i class="fa-solid fa-trash"></i> ลบ
                    </button>
                    <button id="btnBringForward" class="hover:text-indigo-400 transition flex items-center gap-1">
                        <i class="fa-solid fa-layer-group"></i> ย้ายขึ้น
                    </button>
                </div>
            </div>
        </section>

        <!-- Right Sidebar / Bottom Drawer for Mobile -->
        <aside class="w-full lg:w-96 bg-slate-900 border-t lg:border-t-0 lg:border-l border-slate-800 flex flex-col h-[55vh] lg:h-full shrink-0 z-10">
            
            <!-- Tab Headers -->
            <div class="flex border-b border-slate-800 bg-slate-900/50 overflow-x-auto shrink-0 scrollbar-none">
                <button data-tab="camera" class="tab-btn active flex-1 py-3 px-3 text-xs sm:text-sm font-medium text-pink-400 border-b-2 border-pink-500 flex flex-col items-center gap-1 min-w-[70px]">
                    <i class="fa-solid fa-camera text-base"></i>
                    <span>กล้อง/รูป</span>
                </button>
                <button data-tab="frames" class="tab-btn flex-1 py-3 px-3 text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 border-b-2 border-transparent flex flex-col items-center gap-1 min-w-[70px]">
                    <i class="fa-solid fa-border-all text-base"></i>
                    <span>กรอบรูป</span>
                </button>
                <button data-tab="text" class="tab-btn flex-1 py-3 px-3 text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 border-b-2 border-transparent flex flex-col items-center gap-1 min-w-[70px]">
                    <i class="fa-solid fa-font text-base"></i>
                    <span>ข้อความ</span>
                </button>
                <button data-tab="stickers" class="tab-btn flex-1 py-3 px-3 text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 border-b-2 border-transparent flex flex-col items-center gap-1 min-w-[70px]">
                    <i class="fa-solid fa-icons text-base"></i>
                    <span>กราฟิก</span>
                </button>
                <button data-tab="canvas" class="tab-btn flex-1 py-3 px-3 text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 border-b-2 border-transparent flex flex-col items-center gap-1 min-w-[70px]">
                    <i class="fa-solid fa-sliders text-base"></i>
                    <span>ขนาด/พื้น</span>
                </button>
            </div>

            <!-- Tab Contents -->
            <div class="flex-1 overflow-y-auto p-4 space-y-4">

                <!-- TAB 1: CAMERA & IMAGE UPLOAD -->
                <div id="tab-camera" class="tab-content space-y-4">
                    <div class="space-y-2">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">ถ่ายรูปภาพด้วยกล้อง</label>
                        
                        <!-- Camera Viewfinder Container -->
                        <div class="relative bg-slate-950 rounded-xl border border-slate-800 overflow-hidden aspect-video flex items-center justify-center">
                            <video id="cameraFeed" class="w-full h-full object-cover hidden" autoplay playsinline></video>
                            <div id="cameraPlaceholder" class="text-center p-4">
                                <i class="fa-solid fa-video-slash text-3xl text-slate-600 mb-2"></i>
                                <p class="text-xs text-slate-400">ยังไม่ได้เปิดกล้อง</p>
                            </div>
                        </div>

                        <div class="flex gap-2">
                            <button id="btnStartCamera" class="flex-1 py-2 px-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-medium transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-video"></i>
                                <span>เปิดกล้อง</span>
                            </button>
                            <button id="btnCapture" class="flex-1 py-2 px-3 bg-pink-600 hover:bg-pink-500 text-white rounded-lg text-xs font-medium transition flex items-center justify-center gap-2 hidden">
                                <i class="fa-solid fa-circle-dot"></i>
                                <span>ถ่ายรูป</span>
                            </button>
                            <button id="btnStopCamera" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-medium transition hidden">
                                <i class="fa-solid fa-stop"></i>
                            </button>
                        </div>
                    </div>

                    <div class="relative flex py-2 items-center">
                        <div class="flex-grow border-t border-slate-800"></div>
                        <span class="flex-shrink mx-3 text-xs text-slate-500">หรือ</span>
                        <div class="flex-grow border-t border-slate-800"></div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">อัปโหลดรูปภาพ</label>
                        <label class="flex flex-col items-center justify-center w-full h-28 border-2 border-slate-800 border-dashed rounded-xl cursor-pointer bg-slate-950 hover:bg-slate-800/50 transition">
                            <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                <i class="fa-solid fa-cloud-arrow-up text-2xl text-pink-400 mb-1"></i>
                                <p class="text-xs text-slate-300 font-medium">คลิกเพื่ออัปโหลดรูปภาพ</p>
                                <p class="text-[10px] text-slate-500">PNG, JPG, WEBP</p>
                            </div>
                            <input id="fileInput" type="file" accept="image/*" class="hidden" />
                        </label>
                    </div>
                </div>

                <!-- TAB 2: FRAMES -->
                <div id="tab-frames" class="tab-content space-y-4 hidden">
                    <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">เลือกกรอบรูปตกแต่ง</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button class="frame-option border-2 border-pink-500/50 rounded-xl p-3 bg-slate-950 hover:bg-slate-800 text-left transition flex flex-col items-center gap-2 group" data-frame="none">
                            <div class="w-full h-16 bg-slate-900 rounded border border-slate-700 flex items-center justify-center">
                                <i class="fa-solid fa-ban text-slate-500"></i>
                            </div>
                            <span class="text-xs font-medium text-slate-300 group-hover:text-pink-400">ไม่มีกรอบ</span>
                        </button>
                        
                        <button class="frame-option border-2 border-slate-800 rounded-xl p-3 bg-slate-950 hover:bg-slate-800 text-left transition flex flex-col items-center gap-2 group" data-frame="classic">
                            <div class="w-full h-16 bg-slate-900 rounded border-8 border-slate-200 flex items-center justify-center">
                                <div class="w-full h-full border-2 border-amber-600"></div>
                            </div>
                            <span class="text-xs font-medium text-slate-300 group-hover:text-pink-400">คลาสสิก หรูหรา</span>
                        </button>

                        <button class="frame-option border-2 border-slate-800 rounded-xl p-3 bg-slate-950 hover:bg-slate-800 text-left transition flex flex-col items-center gap-2 group" data-frame="polaroid">
                            <div class="w-full h-16 bg-white rounded p-1 pb-4 flex items-center justify-center">
                                <div class="w-full h-full bg-slate-700 rounded-sm"></div>
                            </div>
                            <span class="text-xs font-medium text-slate-300 group-hover:text-pink-400">โพลารอยด์</span>
                        </button>

                        <button class="frame-option border-2 border-slate-800 rounded-xl p-3 bg-slate-950 hover:bg-slate-800 text-left transition flex flex-col items-center gap-2 group" data-frame="neon">
                            <div class="w-full h-16 bg-slate-950 rounded border-2 border-pink-500 shadow-[0_0_10px_rgba(236,72,153,0.8)] flex items-center justify-center">
                                <div class="w-full h-full border border-cyan-400"></div>
                            </div>
                            <span class="text-xs font-medium text-slate-300 group-hover:text-pink-400">นีออน (Neon)</span>
                        </button>

                        <button class="frame-option border-2 border-slate-800 rounded-xl p-3 bg-slate-950 hover:bg-slate-800 text-left transition flex flex-col items-center gap-2 group" data-frame="cute">
                            <div class="w-full h-16 bg-slate-900 rounded border-4 border-dashed border-pink-300 flex items-center justify-center">
                                <i class="fa-solid fa-heart text-pink-400 text-xs"></i>
                            </div>
                            <span class="text-xs font-medium text-slate-300 group-hover:text-pink-400">น่ารัก/พาสเทล</span>
                        </button>

                        <button class="frame-option border-2 border-slate-800 rounded-xl p-3 bg-slate-950 hover:bg-slate-800 text-left transition flex flex-col items-center gap-2 group" data-frame="vignette">
                            <div class="w-full h-16 bg-slate-900 rounded radial-vignette flex items-center justify-center border border-slate-700">
                                <span class="text-[10px] text-slate-400">เงาดำ</span>
                            </div>
                            <span class="text-xs font-medium text-slate-300 group-hover:text-pink-400">เงาขอบภาพ</span>
                        </button>
                    </div>
                </div>

                <!-- TAB 3: TEXT -->
                <div id="tab-text" class="tab-content space-y-4 hidden">
                    <div class="space-y-3">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">เพิ่มข้อความ</label>
                        <div class="flex gap-2">
                            <input id="textInput" type="text" placeholder="พิมพ์ข้อความที่นี่..." class="flex-1 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-pink-500">
                            <button id="btnAddText" class="px-4 py-2 bg-pink-600 hover:bg-pink-500 text-white rounded-lg text-sm font-semibold transition">
                                เพิ่ม
                            </button>
                        </div>
                    </div>

                    <div class="space-y-3 pt-2 border-t border-slate-800">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">รูปแบบฟอนต์</label>
                        <select id="fontFamilySelect" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-pink-500">
                            <option value="Prompt" class="font-prompt">Prompt (ทางการ/ทันสมัย)</option>
                            <option value="Itim" class="font-itim">Itim (น่ารัก/กันเอง)</option>
                            <option value="Sriracha" class="font-sriracha">Sriracha (ลายมือเขียน)</option>
                            <option value="Mitr" class="font-mitr">Mitr (หัวกลมอ่านง่าย)</option>
                            <option value="Chakra Petch" class="font-chakra">Chakra Petch (เทค/ดิจิทัล)</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-2">
                        <div>
                            <label class="text-xs text-slate-400 mb-1 block">สีข้อความ</label>
                            <input id="textColorInput" type="color" value="#ffffff" class="w-full h-10 bg-slate-950 border border-slate-700 rounded-lg cursor-pointer p-1">
                        </div>
                        <div>
                            <label class="text-xs text-slate-400 mb-1 block">สีเส้นขอบ (Stroke)</label>
                            <input id="textStrokeColorInput" type="color" value="#000000" class="w-full h-10 bg-slate-950 border border-slate-700 rounded-lg cursor-pointer p-1">
                        </div>
                    </div>

                    <div class="space-y-2 pt-2">
                        <div class="flex justify-between text-xs text-slate-400">
                            <span>ขนาดข้อความ</span>
                            <span id="textSizeVal">40px</span>
                        </div>
                        <input id="textSizeInput" type="range" min="16" max="120" value="40" class="w-full accent-pink-500">
                    </div>
                </div>

                <!-- TAB 4: STICKERS & GRAPHICS -->
                <div id="tab-stickers" class="tab-content space-y-4 hidden">
                    <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">เลือกสติกเกอร์ / อีโมจิ</label>
                    
                    <div class="grid grid-cols-5 gap-2 text-2xl">
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="❤️">❤️</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="✨">✨</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="🔥">🔥</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="👑">👑</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="🎉">🎉</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="🌸">🌸</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="🎀">🎀</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="⭐">⭐</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="😎">😎</button>
                        <button class="sticker-btn bg-slate-950 hover:bg-slate-800 p-2 rounded-xl text-center transition border border-slate-800 hover:border-pink-500" data-emoji="🐱">🐱</button>
                    </div>

                    <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block pt-2">รูปทรงเรขาคณิต</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button id="btnAddShapeCircle" class="py-2.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 hover:border-pink-500 rounded-xl flex flex-col items-center justify-center gap-1 transition">
                            <div class="w-5 h-5 rounded-full bg-pink-500"></div>
                            <span class="text-[10px] text-slate-300">วงกลม</span>
                        </button>
                        <button id="btnAddShapeRect" class="py-2.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 hover:border-pink-500 rounded-xl flex flex-col items-center justify-center gap-1 transition">
                            <div class="w-5 h-5 bg-indigo-500 rounded-sm"></div>
                            <span class="text-[10px] text-slate-300">สี่เหลี่ยม</span>
                        </button>
                        <button id="btnAddShapeStar" class="py-2.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 hover:border-pink-500 rounded-xl flex flex-col items-center justify-center gap-1 transition">
                            <i class="fa-solid fa-star text-amber-400 text-lg"></i>
                            <span class="text-[10px] text-slate-300">ดาว</span>
                        </button>
                    </div>
                </div>

                <!-- TAB 5: CANVAS & BACKGROUND -->
                <div id="tab-canvas" class="tab-content space-y-4 hidden">
                    <div class="space-y-3">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">อัตราส่วนภาพ (Aspect Ratio)</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button data-ratio="1:1" class="ratio-btn bg-slate-950 border border-pink-500 text-pink-400 py-2 rounded-lg text-xs font-medium flex flex-col items-center justify-center gap-1">
                                <span class="font-bold">1:1</span>
                                <span class="text-[10px] text-slate-400">จัตุรัส</span>
                            </button>
                            <button data-ratio="4:3" class="ratio-btn bg-slate-950 border border-slate-800 text-slate-300 py-2 rounded-lg text-xs font-medium flex flex-col items-center justify-center gap-1">
                                <span class="font-bold">4:3</span>
                                <span class="text-[10px] text-slate-400">มาตรฐาน</span>
                            </button>
                            <button data-ratio="9:16" class="ratio-btn bg-slate-950 border border-slate-800 text-slate-300 py-2 rounded-lg text-xs font-medium flex flex-col items-center justify-center gap-1">
                                <span class="font-bold">9:16</span>
                                <span class="text-[10px] text-slate-400">สตอรี่</span>
                            </button>
                        </div>
                    </div>

                    <div class="space-y-3 pt-2 border-t border-slate-800">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">สีพื้นหลัง Canvas</label>
                        <div class="flex items-center gap-3">
                            <input id="bgColorInput" type="color" value="#0f172a" class="w-12 h-10 bg-slate-950 border border-slate-700 rounded-lg cursor-pointer p-1">
                            <span class="text-xs text-slate-300">เปลี่ยนสีฉากหลังกรณีไม่มีรูปถ่าย</span>
                        </div>
                    </div>
                </div>

            </div>
        </aside>

    </main>

    <script>
        // DOM Elements
        const canvas = document.getElementById('mainCanvas');
        const ctx = canvas.getContext('2d');
        const canvasDimText = document.getElementById('canvasDimText');
        const cameraFeed = document.getElementById('cameraFeed');
        const cameraPlaceholder = document.getElementById('cameraPlaceholder');
        const btnStartCamera = document.getElementById('btnStartCamera');
        const btnCapture = document.getElementById('btnCapture');
        const btnStopCamera = document.getElementById('btnStopCamera');
        const fileInput = document.getElementById('fileInput');
        const selectedElementToolbar = document.getElementById('selectedElementToolbar');
        const btnDeleteSelected = document.getElementById('btnDeleteSelected');
        const btnBringForward = document.getElementById('btnBringForward');
        
        // Canvas State Variables
        let canvasWidth = 1080;
        let canvasHeight = 1080;
        let bgImage = null;
        let selectedFrame = 'none';
        let backgroundColor = '#0f172a';
        
        // Interactive Elements Layer State
        let elements = [];
        let activeElementIndex = -1;
        let isDragging = false;
        let isResizing = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let mediaStream = null;

        // Initialize Canvas Setup
        function initCanvas() {
            canvas.width = canvasWidth;
            canvas.height = canvasHeight;
            canvasDimText.textContent = `${canvasWidth} x ${canvasHeight} px`;
            renderCanvas();
        }

        // Main Canvas Render Loop
        function renderCanvas() {
            // Clear Background
            ctx.fillStyle = backgroundColor;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Background Photo if existing
            if (bgImage) {
                drawCoverImage(bgImage);
            }

            // Draw Selected Frame Overlays
            drawFrameOverlay();

            // Render Layered User Elements (Text, Stickers, Shapes)
            elements.forEach((el, index) => {
                ctx.save();
                ctx.translate(el.x, el.y);
                ctx.rotate((el.rotation || 0) * Math.PI / 180);

                if (el.type === 'text') {
                    ctx.font = `${el.fontSize}px "${el.fontFamily}"`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';

                    // Stroke
                    if (el.strokeColor) {
                        ctx.strokeStyle = el.strokeColor;
                        ctx.lineWidth = Math.max(2, el.fontSize / 10);
                        ctx.strokeText(el.text, 0, 0);
                    }
                    // Fill
                    ctx.fillStyle = el.color;
                    ctx.fillText(el.text, 0, 0);

                    // Compute Bounding Box for Interaction
                    const metrics = ctx.measureText(el.text);
                    el.width = metrics.width + 20;
                    el.height = el.fontSize * 1.2;

                } else if (el.type === 'emoji') {
                    ctx.font = `${el.size}px sans-serif`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(el.emoji, 0, 0);
                    el.width = el.size;
                    el.height = el.size;

                } else if (el.type === 'shape') {
                    ctx.fillStyle = el.color;
                    if (el.shapeType === 'circle') {
                        ctx.beginPath();
                        ctx.arc(0, 0, el.size / 2, 0, Math.PI * 2);
                        ctx.fill();
                    } else if (el.shapeType === 'rect') {
                        ctx.fillRect(-el.size / 2, -el.size / 2, el.size, el.size);
                    } else if (el.shapeType === 'star') {
                        drawStar(ctx, 0, 0, 5, el.size / 2, el.size / 4);
                    }
                    el.width = el.size;
                    el.height = el.size;
                }

                // Render Active Selection Boundary Box & Drag Handle
                if (index === activeElementIndex) {
                    ctx.strokeStyle = '#ec4899';
                    ctx.lineWidth = 3;
                    ctx.strokeRect(-el.width / 2 - 5, -el.height / 2 - 5, el.width + 10, el.height + 10);

                    // Scale Handle (Bottom Right)
                    ctx.fillStyle = '#ec4899';
                    ctx.beginPath();
                    ctx.arc(el.width / 2 + 5, el.height / 2 + 5, 8, 0, Math.PI * 2);
                    ctx.fill();
                }

                ctx.restore();
            });

            // Toggle Selected Element Floating Toolbar Visibility
            if (activeElementIndex >= 0) {
                selectedElementToolbar.classList.remove('hidden');
            } else {
                selectedElementToolbar.classList.add('hidden');
            }
        }

        // Fit & Draw Background Photo smoothly into Canvas
        function drawCoverImage(img) {
            const imgRatio = img.width / img.height;
            const canvasRatio = canvas.width / canvas.height;
            let renderW, renderH, offsetX, offsetY;

            if (imgRatio > canvasRatio) {
                renderH = canvas.height;
                renderW = img.width * (canvas.height / img.height);
                offsetX = (canvas.width - renderW) / 2;
                offsetY = 0;
            } else {
                renderW = canvas.width;
                renderH = img.height * (canvas.width / img.width);
                offsetX = 0;
                offsetY = (canvas.height - renderH) / 2;
            }

            ctx.drawImage(img, offsetX, offsetY, renderW, renderH);
        }

        // Draw Selected Frame Style
        function drawFrameOverlay() {
            const w = canvas.width;
            const h = canvas.height;

            if (selectedFrame === 'classic') {
                ctx.strokeStyle = '#f59e0b'; // Gold border
                ctx.lineWidth = 30;
                ctx.strokeRect(15, 15, w - 30, h - 30);
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 6;
                ctx.strokeRect(33, 33, w - 66, h - 66);

            } else if (selectedFrame === 'polaroid') {
                const borderBottom = h * 0.18;
                const borderSides = w * 0.05;

                ctx.fillStyle = '#ffffff';
                // Top, Left, Right, Bottom polaroid border
                ctx.fillRect(0, 0, w, borderSides);
                ctx.fillRect(0, 0, borderSides, h);
                ctx.fillRect(w - borderSides, 0, borderSides, h);
                ctx.fillRect(0, h - borderBottom, w, borderBottom);

            } else if (selectedFrame === 'neon') {
                ctx.strokeStyle = '#ec4899';
                ctx.shadowColor = '#ec4899';
                ctx.shadowBlur = 20;
                ctx.lineWidth = 16;
                ctx.strokeRect(20, 20, w - 40, h - 40);

                ctx.strokeStyle = '#22d3ee';
                ctx.shadowColor = '#22d3ee';
                ctx.shadowBlur = 15;
                ctx.lineWidth = 8;
                ctx.strokeRect(35, 35, w - 70, h - 70);
                
                // Reset shadow blur
                ctx.shadowBlur = 0;

            } else if (selectedFrame === 'cute') {
                ctx.strokeStyle = '#f472b6';
                ctx.lineWidth = 16;
                ctx.setLineDash([25, 15]);
                ctx.strokeRect(20, 20, w - 40, h - 40);
                ctx.setLineDash([]); // Reset dash

            } else if (selectedFrame === 'vignette') {
                const gradient = ctx.createRadialGradient(w/2, h/2, Math.min(w,h)*0.3, w/2, h/2, Math.min(w,h)*0.7);
                gradient.addColorStop(0, 'rgba(0, 0, 0, 0)');
                gradient.addColorStop(1, 'rgba(0, 0, 0, 0.7)');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, w, h);
            }
        }

        // Helper: Draw Star Shape
        function drawStar(ctx, cx, cy, spikes, outerRadius, innerRadius) {
            let rot = Math.PI / 2 * 3;
            let x = cx;
            let y = cy;
            let step = Math.PI / spikes;

            ctx.beginPath();
            ctx.moveTo(cx, cy - outerRadius);
            for (let i = 0; i < spikes; i++) {
                x = cx + Math.cos(rot) * outerRadius;
                y = cy + Math.sin(rot) * outerRadius;
                ctx.lineTo(x, y);
                rot += step;

                x = cx + Math.cos(rot) * innerRadius;
                y = cy + Math.sin(rot) * innerRadius;
                ctx.lineTo(x, y);
                rot += step;
            }
            ctx.lineTo(cx, cy - outerRadius);
            ctx.closePath();
            ctx.fill();
        }

        // Convert screen event coordinates to Canvas coordinates
        function getCanvasCoords(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;

            return {
                x: (clientX - rect.left) * scaleX,
                y: (clientY - rect.top) * scaleY
            };
        }

        // Check if point hits active element's resize handle
        function hitTestResizeHandle(el, x, y) {
            const handleX = el.x + el.width / 2 + 5;
            const handleY = el.y + el.height / 2 + 5;
            const dist = Math.hypot(x - handleX, y - handleY);
            return dist <= 20;
        }

        // Check if point hits an element
        function hitTestElement(el, x, y) {
            const halfW = el.width / 2;
            const halfH = el.height / 2;
            return x >= el.x - halfW && x <= el.x + halfW && y >= el.y - halfH && y <= el.y + halfH;
        }

        // Drag & Resize Mouse/Touch Listeners
        function handleStart(e) {
            const coords = getCanvasCoords(e);
            
            // First check resize handle of currently selected item
            if (activeElementIndex >= 0) {
                const el = elements[activeElementIndex];
                if (hitTestResizeHandle(el, coords.x, coords.y)) {
                    isResizing = true;
                    dragStartX = coords.x;
                    dragStartY = coords.y;
                    return;
                }
            }

            // Check element selection top-down
            let clickedIndex = -1;
            for (let i = elements.length - 1; i >= 0; i--) {
                if (hitTestElement(elements[i], coords.x, coords.y)) {
                    clickedIndex = i;
                    break;
                }
            }

            activeElementIndex = clickedIndex;

            if (activeElementIndex >= 0) {
                isDragging = true;
                dragStartX = coords.x - elements[activeElementIndex].x;
                dragStartY = coords.y - elements[activeElementIndex].y;
            }

            renderCanvas();
        }

        function handleMove(e) {
            if (!isDragging && !isResizing) return;
            const coords = getCanvasCoords(e);

            if (isDragging && activeElementIndex >= 0) {
                elements[activeElementIndex].x = coords.x - dragStartX;
                elements[activeElementIndex].y = coords.y - dragStartY;
                renderCanvas();
            } else if (isResizing && activeElementIndex >= 0) {
                const el = elements[activeElementIndex];
                const dx = coords.x - dragStartX;
                
                if (el.type === 'text') {
                    el.fontSize = Math.max(12, el.fontSize + dx * 0.2);
                } else if (el.type === 'emoji' || el.type === 'shape') {
                    el.size = Math.max(15, el.size + dx * 0.2);
                }
                dragStartX = coords.x;
                dragStartY = coords.y;
                renderCanvas();
            }
        }

        function handleEnd() {
            isDragging = false;
            isResizing = false;
        }

        canvas.addEventListener('mousedown', handleStart);
        canvas.addEventListener('mousemove', handleMove);
        window.addEventListener('mouseup', handleEnd);

        canvas.addEventListener('touchstart', handleStart, { passive: true });
        canvas.addEventListener('touchmove', handleMove, { passive: true });
        window.addEventListener('touchend', handleEnd);

        // Camera Functionality
        btnStartCamera.addEventListener('click', async () => {
            try {
                mediaStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
                cameraFeed.srcObject = mediaStream;
                cameraFeed.classList.remove('hidden');
                cameraPlaceholder.classList.add('hidden');
                btnStartCamera.classList.add('hidden');
                btnCapture.classList.remove('hidden');
                btnStopCamera.classList.remove('hidden');
            } catch (err) {
                alert('ไม่สามารถเปิดใช้งานกล้องได้ กรุณาตรวจสอบสิทธิ์การเข้าถึงกล้อง');
            }
        });

        btnStopCamera.addEventListener('click', stopCamera);

        function stopCamera() {
            if (mediaStream) {
                mediaStream.getTracks().forEach(track => track.stop());
                mediaStream = null;
            }
            cameraFeed.classList.add('hidden');
            cameraPlaceholder.classList.remove('hidden');
            btnStartCamera.classList.remove('hidden');
            btnCapture.classList.add('hidden');
            btnStopCamera.classList.add('hidden');
        }

        btnCapture.addEventListener('click', () => {
            if (!cameraFeed.srcObject) return;
            
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = cameraFeed.videoWidth || 1280;
            tempCanvas.height = cameraFeed.videoHeight || 720;
            const tempCtx = tempCanvas.getContext('2d');
            tempCtx.drawImage(cameraFeed, 0, 0, tempCanvas.width, tempCanvas.height);

            const img = new Image();
            img.onload = () => {
                bgImage = img;
                renderCanvas();
                stopCamera();
            };
            img.src = tempCanvas.toDataURL('image/png');
        });

        // Image File Upload
        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                    bgImage = img;
                    renderCanvas();
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        });

        // Tab Navigation Logic
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('active', 'text-pink-400', 'border-pink-500');
                    b.classList.add('text-slate-400', 'border-transparent');
                });
                document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));

                btn.classList.add('active', 'text-pink-400', 'border-pink-500');
                btn.classList.remove('text-slate-400', 'border-transparent');
                
                const tabId = btn.getAttribute('data-tab');
                document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            });
        });

        // Add Text Element
        document.getElementById('btnAddText').addEventListener('click', () => {
            const textInput = document.getElementById('textInput');
            const text = textInput.value.trim() || 'ข้อความของคุณ';
            
            elements.push({
                type: 'text',
                text: text,
                x: canvas.width / 2,
                y: canvas.height / 2,
                fontSize: parseInt(document.getElementById('textSizeInput').value),
                fontFamily: document.getElementById('fontFamilySelect').value,
                color: document.getElementById('textColorInput').value,
                strokeColor: document.getElementById('textStrokeColorInput').value,
                width: 100,
                height: 40
            });

            activeElementIndex = elements.length - 1;
            textInput.value = '';
            renderCanvas();
        });

        // Realtime Text Controls Updates
        document.getElementById('textSizeInput').addEventListener('input', (e) => {
            document.getElementById('textSizeVal').textContent = `${e.target.value}px`;
            if (activeElementIndex >= 0 && elements[activeElementIndex].type === 'text') {
                elements[activeElementIndex].fontSize = parseInt(e.target.value);
                renderCanvas();
            }
        });

        document.getElementById('textColorInput').addEventListener('input', (e) => {
            if (activeElementIndex >= 0 && elements[activeElementIndex].type === 'text') {
                elements[activeElementIndex].color = e.target.value;
                renderCanvas();
            }
        });

        document.getElementById('textStrokeColorInput').addEventListener('input', (e) => {
            if (activeElementIndex >= 0 && elements[activeElementIndex].type === 'text') {
                elements[activeElementIndex].strokeColor = e.target.value;
                renderCanvas();
            }
        });

        document.getElementById('fontFamilySelect').addEventListener('change', (e) => {
            if (activeElementIndex >= 0 && elements[activeElementIndex].type === 'text') {
                elements[activeElementIndex].fontFamily = e.target.value;
                renderCanvas();
            }
        });

        // Add Emoji Stickers
        document.querySelectorAll('.sticker-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const emoji = btn.getAttribute('data-emoji');
                elements.push({
                    type: 'emoji',
                    emoji: emoji,
                    x: canvas.width / 2,
                    y: canvas.height / 2,
                    size: 80,
                    width: 80,
                    height: 80
                });
                activeElementIndex = elements.length - 1;
                renderCanvas();
            });
        });

        // Add Shape Elements
        document.getElementById('btnAddShapeCircle').addEventListener('click', () => {
            elements.push({
                type: 'shape',
                shapeType: 'circle',
                color: '#ec4899',
                x: canvas.width / 2,
                y: canvas.height / 2,
                size: 100,
                width: 100,
                height: 100
            });
            activeElementIndex = elements.length - 1;
            renderCanvas();
        });

        document.getElementById('btnAddShapeRect').addEventListener('click', () => {
            elements.push({
                type: 'shape',
                shapeType: 'rect',
                color: '#6366f1',
                x: canvas.width / 2,
                y: canvas.height / 2,
                size: 100,
                width: 100,
                height: 100
            });
            activeElementIndex = elements.length - 1;
            renderCanvas();
        });

        document.getElementById('btnAddShapeStar').addEventListener('click', () => {
            elements.push({
                type: 'shape',
                shapeType: 'star',
                color: '#f59e0b',
                x: canvas.width / 2,
                y: canvas.height / 2,
                size: 110,
                width: 110,
                height: 110
            });
            activeElementIndex = elements.length - 1;
            renderCanvas();
        });

        // Frames Option Select
        document.querySelectorAll('.frame-option').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.frame-option').forEach(b => {
                    b.classList.remove('border-pink-500');
                    b.classList.add('border-slate-800');
                });
                btn.classList.remove('border-slate-800');
                btn.classList.add('border-pink-500');
                
                selectedFrame = btn.getAttribute('data-frame');
                renderCanvas();
            });
        });

        // Aspect Ratio Selector
        document.querySelectorAll('.ratio-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.ratio-btn').forEach(b => {
                    b.classList.remove('border-pink-500', 'text-pink-400');
                    b.classList.add('border-slate-800', 'text-slate-300');
                });
                btn.classList.remove('border-slate-800', 'text-slate-300');
                btn.classList.add('border-pink-500', 'text-pink-400');

                const ratio = btn.getAttribute('data-ratio');
                if (ratio === '1:1') {
                    canvasWidth = 1080;
                    canvasHeight = 1080;
                } else if (ratio === '4:3') {
                    canvasWidth = 1200;
                    canvasHeight = 900;
                } else if (ratio === '9:16') {
                    canvasWidth = 1080;
                    canvasHeight = 1920;
                }
                initCanvas();
            });
        });

        // Background Color Input
        document.getElementById('bgColorInput').addEventListener('input', (e) => {
            backgroundColor = e.target.value;
            renderCanvas();
        });

        // Delete & Layer Order Toolbar Controls
        btnDeleteSelected.addEventListener('click', () => {
            if (activeElementIndex >= 0) {
                elements.splice(activeElementIndex, 1);
                activeElementIndex = -1;
                renderCanvas();
            }
        });

        btnBringForward.addEventListener('click', () => {
            if (activeElementIndex >= 0 && activeElementIndex < elements.length - 1) {
                const item = elements.splice(activeElementIndex, 1)[0];
                elements.push(item);
                activeElementIndex = elements.length - 1;
                renderCanvas();
            }
        });

        // Reset Canvas
        document.getElementById('btnResetCanvas').addEventListener('click', () => {
            bgImage = null;
            elements = [];
            activeElementIndex = -1;
            selectedFrame = 'none';
            renderCanvas();
        });

        // Download Final Image
        document.getElementById('btnDownload').addEventListener('click', () => {
            // Unselect element before saving to remove bounding boxes
            const prevActiveIndex = activeElementIndex;
            activeElementIndex = -1;
            renderCanvas();

            // Create download link
            const link = document.createElement('a');
            link.download = `photo-studio-${Date.now()}.png`;
            link.href = canvas.toDataURL('image/png', 1.0);
            link.click();

            // Restore selection state
            activeElementIndex = prevActiveIndex;
            renderCanvas();
        });

        // Startup Initialization
        window.onload = () => {
            initCanvas();
        };
    </script>
</body>
</html>
